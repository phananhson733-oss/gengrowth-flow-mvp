<?xml version="1.0" encoding="UTF-8"?>
<!-- gengrowth.ai blog publish ticker (LANE A) — fires hourly, publishes ready drafts.
     INSTALL (run yourself):
       cp tools/scripts/com.gengrowth.gengrowth-publish.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gengrowth.gengrowth-publish.plist
     STOP:
       launchctl bootout gui/$(id -u)/com.gengrowth.gengrowth-publish
     Runs in the user (Aqua) session — it needs the user keychain (supabase token) + node;
     do NOT set LimitLoadToSessionType=Background (that pins it to the pre-login session,
     which can't reach the keychain). ProcessType=Background just sets scheduling priority.
     Single-instanced (PID-liveness mutex); publish-only + idempotent (already-live skipped). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gengrowth.gengrowth-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/awayer_mini/gengrowth-flow-mvp/tools/scripts/gg-gengrowth-publish-tick.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/awayer_mini/gengrowth-agents/cron-sync/gengrowth-publish/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/awayer_mini/gengrowth-agents/cron-sync/gengrowth-publish/launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
