<?xml version="1.0" encoding="UTF-8"?>
<!-- SEO publish autopilot — fires the tick every 25 min (≈ the 20–30 min stagger).
     INSTALL (run yourself):
       cp tools/scripts/com.gengrowth.seo-autopilot.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gengrowth.seo-autopilot.plist
     STOP:
       launchctl bootout gui/$(id -u)/com.gengrowth.seo-autopilot
     Runs in the user (Aqua) session — the tick needs the user keychain + claude/gh CLIs; do
     NOT set LimitLoadToSessionType=Background (pins to pre-login, no keychain). Each tick is
     single-instanced + publish-only (GG_AUTOPILOT_MODE below) — never authors. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gengrowth.seo-autopilot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/awayer_mini/gengrowth-flow-mvp/tools/scripts/gg-seo-autopilot-tick.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- publish-only (2026-06-17): the cron NEVER authors on this machine (canonical
         runbook); it only claims ready drafts + verify/merges previews to prod. -->
    <key>GG_AUTOPILOT_MODE</key>
    <string>publish-only</string>
    <!-- codex factual-review gate (2026-06-21): the publish gate's codex review is the only step
         that fact-checks real-world claims and it now PARKS on a non-PASS. Point GG_CODEX_BIN at the
         wrapper; codex itself must be installed + authenticated (preflight stands the fire down with
         an alert if it is not). Set GG_CODEX_GATE_REQUIRED=0 here only for an emergency codex-less run. -->
    <key>GG_CODEX_BIN</key>
    <string>/Users/awayer_mini/gengrowth-flow-mvp/tools/scripts/gg-codex-pr-review.mjs</string>
  </dict>
  <key>StartInterval</key>
  <integer>1500</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- NO LimitLoadToSessionType: the tick needs the user (Aqua) keychain + claude/gh/codex CLIs.
       Pinning to Background loads it pre-login with no keychain (see the header comment) — the
       gui/$(id -u) bootstrap above is the supported load. Removed 2026-06-21 (file had contradicted
       its own header). ProcessType=Background below is fine (scheduling hint, not a session pin). -->
  <key>StandardOutPath</key>
  <string>/Users/awayer_mini/gengrowth-agents/cron-sync/seo_autopilot/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/awayer_mini/gengrowth-agents/cron-sync/seo_autopilot/launchd.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
